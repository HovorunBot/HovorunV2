BOT_TOKEN=your_telegram_bot_token_here
# Server template. make env-init generates private values; development defaults live in docker-compose.dev.yml.
POSTGRES_DB=hovorun
POSTGRES_USER=hovorun
POSTGRES_PASSWORD=
DATABASE_URL=
VALKEY_URL=redis://localhost:6379/0
# Local NLLB model assets retain CC BY-NC 4.0; see THIRD_PARTY_NOTICES.md.
# Compose mounts a persistent translation_models volume at /app/data/models.
TRANSLATION_MODEL_DIR=/app/data/models/nllb-200-distilled-600M-int8
TRANSLATION_TARGET_LANG=uk
TRANSLATION_IGNORED_LANGS=["en", "ru", "uk", "und"]
# Opt in to build Chromium/pydoll-python and start the browser fallback worker.
BROWSER_ENABLED=False

# Prepare with make prepare-speech before enabling the optional CPU speech worker.
SPEECH_ENABLED=False
SPEECH_MODEL_IDLE_TIMEOUT=300
BROWSER_MAX_TABS=4
BROWSER_IDLE_TIMEOUT=600

# Instagram Authentication (Optional, required for restricted content/Reels)
# Get 'sessionid' cookie from your browser after logging into instagram.com
INSTAGRAM_SESSIONID=
# Optional executable override; otherwise search packages, Flatpak, Snap, then browser AppImages.
# BROWSER_PATH=/usr/bin/chromium

# Error Reporting
ERROR_DM_ENABLED=False

# Security
# Generate using: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CACHE_ENCRYPTION_KEY=

# Docker resource ceilings for an 8 GB host; these do not reserve memory.
MEDIA_CONCURRENCY=1
POSTGRES_MEMORY_LIMIT=1g
VALKEY_MEMORY_LIMIT=1g
VALKEY_MAXMEMORY=512mb
BOT_MEMORY_LIMIT=512m
WORKER_MEDIA_MEMORY_LIMIT=1536m
WORKER_BROWSER_MEMORY_LIMIT=1536m
WORKER_COMPRESSION_MEMORY_LIMIT=2g
WORKER_OPERATIONS_MEMORY_LIMIT=512m
BEAT_MEMORY_LIMIT=256m
MIGRATE_MEMORY_LIMIT=512m
