BOT_TOKEN=your_telegram_bot_token_here
# Server template. make env-init generates private values; development defaults live in docker-compose.dev.yml.
POSTGRES_DB=hovorun
POSTGRES_USER=hovorun
POSTGRES_PASSWORD=
DATABASE_URL=
VALKEY_URL=redis://localhost:6379/0
TRANSLATION_TARGET_LANG=uk
TRANSLATION_IGNORED_LANGS=["en", "ru", "uk", "und"]
BROWSER_MAX_TABS=4
BROWSER_IDLE_TIMEOUT=600

# Instagram Authentication (Optional, required for restricted content/Reels)
# Get 'sessionid' cookie from your browser after logging into instagram.com
INSTAGRAM_SESSIONID=
# Optional executable override; otherwise search packages, Flatpak, Snap, then browser AppImages.
# BROWSER_PATH=/usr/bin/chromium

# Error Reporting
ERROR_DM_ENABLED=False

# Security
# Generate using: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CACHE_ENCRYPTION_KEY=